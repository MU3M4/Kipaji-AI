# Kipaji-AI environment variables
# Copy this to .env and fill in your values — never commit .env to git

# ── Required ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=AQ.Ab8RN6KDTKTG-gg7TrhUUGj1abmpJaeYRmZSUZjnC7tAIFGHYQ
GOOGLE_CLOUD_PROJECT=607612919974

# ── Optional (app works without these via in-memory fallbacks) ────────────
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.netlify.app

# Set to "development" to enable hot-reload
ENV=production

# Port (defaults to 8000)
PORT=8000
